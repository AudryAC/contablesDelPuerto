---
import { Icon } from 'astro-icon/components';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const t = ui[lang];
---
<section class="about container" id="nosotros" data-section-reveal aria-labelledby="about-title">
  <div class="about-copy">
    <p class="section-label" data-reveal>{t.about.label}</p>
    <h2 id="about-title" data-reveal style="--reveal-delay: 0.1s" set:html={t.about.title} />
    <p data-reveal style="--reveal-delay: 0.2s" set:html={t.about.p1} />
    <p data-reveal style="--reveal-delay: 0.3s">{t.about.p2}</p>
    <div data-reveal style="--reveal-delay: 0.4s">
      <a href="#contacto" class="btn btn-primary">
        {t.about.button} <Icon name="lucide:arrow-right" class="btn-icon" aria-hidden="true" />
      </a>
    </div>
  </div>

  <div class="about-media" data-reveal style="--reveal-delay: 0.15s">
    <img
      class="about-photo"
      src="/images/iglesia-680.webp"
      srcset="/images/iglesia-680.webp 680w, /images/iglesia-1000.webp 1000w, /images/iglesia.webp 1360w"
      sizes="(max-width: 600px) calc(100vw - 36px), (max-width: 1100px) 45vw, 680px"
      alt={t.about.imageAlt}
      width="1360"
      height="907"
      loading="lazy"
      decoding="async"
    />

    <div class="about-card" data-reveal="repeat" style="--reveal-delay: 0.45s">
      <div class="about-card-icon" aria-hidden="true"><Icon name="lucide:users-round" is:inline /></div>
      <p>{t.about.card}</p>
    </div>
  </div>
</section>
