---
import '../styles/global.css';
import { languages, paths, ui, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
}
const { lang = 'es' } = Astro.props;
const t = ui[lang];
const { title = t.meta.title, description = t.meta.description } = Astro.props;

const site = Astro.site ?? new URL('https://contablesdelpuerto.com');
const canonical = new URL(paths[lang], site).href;
const alternates = languages.map((code) => ({ code, href: new URL(paths[code], site).href }));
const ogImage = new URL('/images/og-image.jpg', site).href;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'AccountingService',
  '@id': `${site.href}#negocio`,
  inLanguage: t.meta.htmlLang,
  name: 'Soluciones Contables del Puerto',
  description,
  url: site.href,
  image: ogImage,
  logo: new URL('/images/brand.svg', site).href,
  telephone: '+52 322 236 5537',
  email: 'delpuerto.conta@gmail.com',
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Cupuri 83, Aramara',
    addressLocality: 'Puerto Vallarta',
    addressRegion: 'Jalisco',
    postalCode: '48314',
    addressCountry: 'MX',
  },
  areaServed: [
    { '@type': 'City', name: 'Puerto Vallarta' },
    { '@type': 'Place', name: 'Bahía de Banderas' },
  ],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '10:00',
      closes: '18:00',
    },
  ],
  founder: [
    { '@type': 'Person', name: 'Ivette Cueto' },
    { '@type': 'Person', name: 'Rogelio Nuno' },
  ],
  sameAs: ['https://www.facebook.com/contablesdelpuerto'],
  hasMap: 'https://www.google.com/maps/search/?api=1&query=Cupuri%2083%2C%20Aramara%2C%2048314%20Puerto%20Vallarta%2C%20Jalisco',
  knowsLanguage: ['es', 'en'],
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+52 322 236 5537',
    email: 'delpuerto.conta@gmail.com',
    contactType: 'customer service',
    areaServed: 'MX',
    availableLanguage: ['Spanish', 'English'],
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: lang === 'es' ? 'Servicios contables' : 'Accounting services',
    itemListElement: t.services.items.map(({ title: name }) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name, areaServed: 'Puerto Vallarta' },
    })),
  },
};
---
<!doctype html>
<html lang={t.meta.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.code} href={alt.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="robots" content="index, follow" />
    <meta name="google-site-verification" content="mM1yy8KocrBp8KpwjOZSblY1N8qdxcRpdtx6qAl7CK0" />
    <meta name="theme-color" content="#082a50" />

    <meta name="geo.region" content="MX-JAL" />
    <meta name="geo.placename" content="Puerto Vallarta" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.meta.ogLocale} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_MX'} />
    <meta property="og:site_name" content="Soluciones Contables del Puerto" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script is:inline>document.documentElement.classList.add('js');</script>

    <link rel="preload" as="image" href="/images/puerto-vallarta.webp" type="image/webp" media="(min-width: 601px)" fetchpriority="high" />
    <link rel="preload" as="image" href="/images/puerto-vallarta-noblur.webp" type="image/webp" media="(max-width: 600px)" fetchpriority="high" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Arimo:wght@400;600;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Arimo:wght@400;600;700&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Arimo:wght@400;600;700&display=swap" /></noscript>
  </head>
  <body>
    <a class="skip-link" href="#contenido">{t.meta.skipLink}</a>
    <slot />
    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const easeInOutCubic = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
      let scrollFrame = 0;

      function smoothScrollTo(target: HTMLElement) {
        let top = 0;
        for (let el: HTMLElement | null = target; el; el = el.offsetParent as HTMLElement | null) top += el.offsetTop;
        const headerOffset = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-offset')) || 0;
        top = Math.max(0, top - headerOffset);
        const finish = () => {
          if (target.id) history.replaceState(null, '', `#${target.id}`);
          if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
          if (!target.contains(document.activeElement)) target.focus({ preventScroll: true });
        };
        cancelAnimationFrame(scrollFrame);
        if (reduceMotion) {
          window.scrollTo(0, top);
          finish();
          return;
        }
        const start = window.scrollY;
        const distance = top - start;
        const duration = Math.min(1400, Math.max(600, Math.abs(distance) * 0.45));
        const startTime = performance.now();
        const step = (now: number) => {
          const progress = Math.min(1, (now - startTime) / duration);
          window.scrollTo(0, start + distance * easeInOutCubic(progress));
          if (progress < 1) scrollFrame = requestAnimationFrame(step);
          else finish();
        };
        scrollFrame = requestAnimationFrame(step);
      }
      window.smoothScrollTo = smoothScrollTo;

      document.addEventListener('click', (e) => {
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const link = (e.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
        const id = link?.getAttribute('href')?.slice(1);
        if (!id) return;
        const target = document.getElementById(id);
        if (!target) return;
        e.preventDefault();
        smoothScrollTo(target);
      });

      const sections = document.querySelectorAll<HTMLElement>('[data-section-reveal]');
      if (reduceMotion || !('IntersectionObserver' in window)) {
        sections.forEach((el) => el.classList.add('is-shown'));
      } else {
        const sectionReveal = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-shown');
                sectionReveal.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.08 },
        );
        sections.forEach((el) => sectionReveal.observe(el));
      }

      const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (reduceMotion || !('IntersectionObserver' in window)) {
        revealItems.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -60px 0px' },
        );

        const repeatBySection = new Map<Element, HTMLElement[]>();
        const sectionObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              repeatBySection.get(entry.target)?.forEach((el) => {
                el.classList.toggle('is-visible', entry.isIntersecting);
              });
            });
          },
          { threshold: 0, rootMargin: '-25% 0px -15% 0px' },
        );

        revealItems.forEach((el) => {
          if (el.dataset.reveal === 'repeat') {
            const section = el.closest('section') ?? el;
            if (!repeatBySection.has(section)) {
              repeatBySection.set(section, []);
              sectionObserver.observe(section);
            }
            repeatBySection.get(section)!.push(el);
          } else {
            observer.observe(el);
          }
        });

        const revealAtPageEnd = () => {
          const atEnd = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 4;
          if (!atEnd) return;
          revealItems.forEach((el) => {
            if (el.dataset.reveal === 'repeat' || el.classList.contains('is-visible')) return;
            if (el.getBoundingClientRect().top < window.innerHeight) {
              el.classList.add('is-visible');
              observer.unobserve(el);
            }
          });
        };
        window.addEventListener('scroll', revealAtPageEnd, { passive: true });
        revealAtPageEnd();
      }

      const parallaxItems = document.querySelectorAll<HTMLElement>('[data-parallax]');
      if (!reduceMotion && parallaxItems.length) {
        let ticking = false;
        const update = () => {
          const y = Math.min(window.scrollY, window.innerHeight * 1.2);
          parallaxItems.forEach((el) => {
            const speed = Number(el.dataset.parallax) || 0;
            el.style.translate = `0 ${(y * speed).toFixed(1)}px`;
          });
          ticking = false;
        };
        window.addEventListener('scroll', () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        }, { passive: true });
        update();
      }
    </script>
  </body>
</html>
